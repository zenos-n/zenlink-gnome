[Desktop Entry]
Type=Application
Name=ZenLink
Exec=gapplication launch org.zenos.ZenLink %U
Terminal=false
NoDisplay=true
Icon=org.zenos.ZenLink
Categories=Network;
MimeType=x-scheme-handler/sms;x-scheme-handler/tel;
DBusActivatable=true
X-GNOME-UsesNotifications=true

